# =============================================================================
# content-ai-generator configuration      cp .env.example .env
#
# Every credential is OPTIONAL. A blank credential puts that integration in mock
# mode (labelled "[MOCK]"). Fill it in and run `docker compose up -d` to go live.
#
# User-level Facebook/Instagram tokens are NOT configured here. Each user connects
# their own accounts in the app; tokens are stored encrypted in PostgreSQL.
# =============================================================================

# --- Public URL ----------------------------------------------------------------
# The URL people and Meta use to reach nginx. OAuth redirect URIs and the
# MCP server URL are derived from it. Use your public HTTPS domain in production
# (Meta must be able to download media you publish, and remote MCP clients need HTTPS).
PUBLIC_BASE_URL=http://localhost

# --- Security --------------------------------------------------------------------
# Fernet key used to encrypt users' Facebook tokens at rest. REQUIRED once META_APP_ID is set.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Shared secret between the MCP server and the backend (token introspection).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# --- Meta app: "Continue with Facebook" sign-in + users' Pages & Instagram ---------
# https://developers.facebook.com/apps -> create a Business app -> add "Facebook Login for Business".
# Add BOTH under Facebook Login -> Settings -> Valid OAuth Redirect URIs:
#   {PUBLIC_BASE_URL}/api/auth/facebook/callback        (sign in / sign up)
#   {PUBLIC_BASE_URL}/api/connections/meta/callback     (connect another Facebook login)
# Until Meta approves your app (App Review + Business Verification), only people with a role
# on the app (admins/developers/testers) can sign in. Blank = demo Facebook login + mock data.
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration ID (defines the permissions requested).
# Blank = request the classic scope list (pages, instagram_basic/insights/content_publish, ...).
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0

# --- Anthropic Claude (plans, chat, classification, hashtag suggestions, cluster names) ---
# https://console.anthropic.com/settings/keys. Blank = deterministic mock generation and
# local embedding-based classification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Embeddings --------------------------------------------------------------------
# Optional. Blank = local sentence-transformers model (no key). Each embedding model gets
# its own Chroma collection; after switching, re-sync accounts.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage -------------------------------------------------------------------------
POSTGRES_USER=content_ai
POSTGRES_PASSWORD=content_ai
POSTGRES_DB=content_ai
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# HOST "postgres" = the compose database container. For an external database use its IP/hostname.
# If you change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above, change them here too.
DATABASE_URL=postgresql+psycopg://content_ai:content_ai@postgres:5432/content_ai
CHROMA_COLLECTION=instagram_content
# How often the worker re-syncs connected accounts.
SYNC_INTERVAL_HOURS=12

# --- MCP server ------------------------------------------------------------------------
# Inside Docker keep 0.0.0.0 / 8765. Clients connect through nginx at {PUBLIC_BASE_URL}/mcp.
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# --- Frontend --------------------------------------------------------------------------
VITE_API_BASE_URL=/api
